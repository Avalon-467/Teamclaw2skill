# ============================================================
#  OASIS 社区模拟 — 统一环境变量配置
#  复制为 .env 并填入你的配置
# ============================================================

# ── LLM API 配置 ──
OASIS_LLM_PLATFORM=deepseek                  # openai / deepseek / qwen / openai-compatible
OASIS_MODEL_NAME=deepseek-chat               # 模型名称
OASIS_API_KEY=sk-your-api-key-here           # API Key (必填)
OASIS_API_URL=                               # API 地址 (留空则使用平台默认)

# ── 嵌入模型配置 (推荐系统用) ──
# 留空则复用上面的 OASIS_API_KEY
OASIS_EMBEDDING_API_KEY=                     # 嵌入 API Key (留空=复用 OASIS_API_KEY)
OASIS_EMBEDDING_API_URL=                     # 嵌入 API 地址 (留空=使用 OpenAI 默认)
OASIS_EMBEDDING_MODEL=text-embedding-3-small # 嵌入模型名称

# ── 社区模拟参数 ──
OASIS_NUM_AGENTS=5
OASIS_COMMUNITY_ROUNDS=3
OASIS_PLATFORM=twitter                       # twitter / reddit
OASIS_MODEL_TEMPERATURE=0.7

# ── 运行模式 ──
OASIS_CONTINUOUS=                            # 留空=有限轮次, 设为 1=持续运行
OASIS_ROUND_DELAY=2.0

# ── 讨论编排 ──
OASIS_SCHEDULE=                              # YAML schedule 文件路径 (如 schedules/debate.yaml)
OASIS_TOPICS_NUM=0                           # CSV 话题注入数 (使用 schedule 时建议 0)
OASIS_INITIAL_POST=                          # 初始帖子内容 (使用 manual 时可留空)
OASIS_REFRESH_REC_POST_COUNT=                # 推荐表采样数 (Agent≤5 建议 5)
OASIS_MAX_REC_POST_LEN=                      # 推荐表缓存上限 (Agent≤5 建议 10)
OASIS_FOLLOWING_POST_COUNT=                  # 关注者帖子数 (Agent≤5 建议 10)

# ── 外部 Agent ──
OASIS_EXTERNAL_AGENTS_CONFIG=                # 外部 Agent JSON 配置文件路径

# ── 可视化 ──
OASIS_VIEWER=true
OASIS_VIEWER_PORT=8001
